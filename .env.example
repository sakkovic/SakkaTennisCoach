# Copy to .env.local and fill in. Without Supabase values the app runs in local
# demo mode (in-memory data, development only).

# Public site URL — used for SEO (canonical URLs, sitemap, OpenGraph) and email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…) or legacy anon key. Safe to expose: RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Transactional email (optional). Without a key, emails are logged to the console.
RESEND_API_KEY=
EMAIL_FROM="Sami Sakka <bookings@your-domain.com>"
# Where new booking requests / contact messages are sent (defaults to config/site.ts email)
COACH_NOTIFICATION_EMAIL=

# Force demo mode in a production build (e.g. a preview without Supabase). Never use for the real site.
# DEMO_MODE=true
